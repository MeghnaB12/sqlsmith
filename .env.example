ENVIRONMENT=local
LOG_LEVEL=INFO

# SQL generation
GENERATOR_PROVIDER=stub
ANTHROPIC_API_KEY=
SQL_MODEL=claude-sonnet-4-5
MAX_ROWS=100

# Product persistence
DATABASE_URL=sqlite:///./sqlsmith.db

# Authentication -- replace outside local development
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=1440

# Browser client
CORS_ORIGINS=http://localhost:3000
